# ============================================================================
# WebGIS 前端生产构建变量（仓库根 · 提交 git · 仅公开 VITE_*）
#
# Vite 的 envDir 已指向仓库根目录：`npm run build`（mode=production）时
# 读取本文件；本地开发读取根 .env（已提交的 L1 非涉密默认配置）。
# 只有 VITE_ 前缀的变量会进入前端构建产物——本文件禁止出现任何绝密。
#
# ⚠️ clone 用户必改：VITE_BACKEND_URL 换成你自己的后端域名，否则构建产物的
#    API / 瓦片代理 / 纠偏 / 自托管瓦片会打到原作者的 HF Space。
# 键名登记：根 .env.example [L1] 前端段 ｜ 说明：Docs/Guide/configuration.md
# ============================================================================

# 后端 API / 瓦片代理基址（生产：Hugging Face Space）
VITE_BACKEND_URL=https://negiao-webgis.hf.space

# 部署基础路径（GitHub Pages 子路径可用 /WebGIS-Dev/；相对路径 ./ 通用）
VITE_BASE_URL=./

# 瓦片代理基址（缺省同 VITE_BACKEND_URL，通常无需单独设置）
# VITE_TILE_PROXY_BASE_URL=
# fallback | always | off
# VITE_TILE_PROXY_MODE=fallback

# 可选：大文件下载超时（ms）
# VITE_DOWNLOAD_REQUEST_TIMEOUT=2000000
