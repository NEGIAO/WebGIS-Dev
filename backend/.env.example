# WebGIS Backend — 环境变量摘要
#
# ⚠️ 权威「全集清单」在仓库根目录：../.env.example
# 仓库根 .env 已作为 L1 非涉密默认配置提交；backend/.env 仍是忽略的本地兼容覆盖入口。
# 本文件仅作后端侧提醒，避免与根清单长期双源分叉。
#
# [L3 HF Secrets] SUPER_USER, OAUTH_STATE_SECRET,
#   GOOGLE_OAUTH_CLIENT_ID/SECRET, GITHUB_OAUTH_CLIENT_ID/SECRET,
#   SMTP_PASSWORD, SUPABASE_*, LOG
# [L1] APP_ENV, BACKEND_PUBLIC_URL, FRONTEND_PUBLIC_URL, SMTP_HOST/PORT/USER, AUTH_* …
# [L2] 地图 token / Agent 主密钥与运营参数 → 管理员面板 + DB，不要写进 git / HF Secrets
#
# docker重建命令
# cd d:\Dev\GitHub\WebGIS-Dev\backend
# docker compose up -d --build --force-recreate

# 详细说明：../Docs/Guide/configuration.md

APP_ENV=development

# 以下为常见本地占位；完整项与注释见根 .env.example
# SUPER_USER=
# OAUTH_STATE_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=80
# SMTP_USER=
# SMTP_PASSWORD=
