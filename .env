# ============================================================
# WebGIS 本地实值配置（git 已忽略，勿提交）
# 完整键目录与分层说明见同目录 .env.example / Docs/Guide/configuration.md
# 改动后需重建后端容器生效：cd backend && docker compose up -d --force-recreate
# ============================================================

# 运行环境：本地必须 development（启用 admin/123456 兜底、OAuth 回调推导 localhost）
APP_ENV=development

# 对外 URL（OAuth 回调与前端回跳由此推导）
BACKEND_PUBLIC_URL=http://localhost:7860
FRONTEND_PUBLIC_URL=http://localhost:5173

# ─── 本地按需启用（参考 .env.example [L3] 段填写真值）───
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SMTP_USER=
# SMTP_PASSWORD=
