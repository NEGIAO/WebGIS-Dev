# ============================================================
# WebGIS L1 非涉密默认配置（已提交，可作为 clone 后的默认基线）
# 完整 key 目录与分层说明见同目录 .env.example / Docs/Guide/configuration.md
# L2 运营配置请登录 admin 写入数据库；L3 绝密请放 HF Secrets / 系统环境变量
# 改动后需重建后端容器生效：cd backend && docker compose up -d --force-recreate
# ============================================================

# 运行环境：本地必须 development（启用 admin/123456 兜底、OAuth 回调推导 localhost）
APP_ENV=development
LOG_LEVEL=INFO

# 对外 URL（OAuth 回调与前端回跳由此推导）
BACKEND_PUBLIC_URL=http://localhost:7860
FRONTEND_PUBLIC_URL=http://localhost:5173

# 认证与 OAuth 非密钥策略
AUTH_DB_PATH=
AUTH_SESSION_EXPIRE_HOURS=72
AUTH_PASSWORD_HASH_ITERATIONS=120000
OAUTH_STATE_TTL_SECONDS=600
OAUTH_TICKET_TTL_SECONDS=120
OAUTH_HTTP_TIMEOUT_SECONDS=15
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_PROFILE_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_OAUTH_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
GITHUB_OAUTH_AUTH_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_PROFILE_URL=https://api.github.com/user
GITHUB_OAUTH_EMAILS_URL=https://api.github.com/user/emails

# 邮件（账号半公开；凭证 SMTP_PASSWORD 属 L3，禁止写入 tracked .env）
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=80
SMTP_USER=

# Agent / LLM 非密钥默认（主密钥和运行时常变项以 L2 Admin + DB 覆盖）
AGENT_BASE_URL=https://llm-3be2tji11xwl7w30.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=
AGENT_SYSTEM_PROMPT=You are the WebGIS assistant. Reply in concise Chinese unless the user asks for another language.
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TOKENS=32768
AGENT_TEMPERATURE=1.0
AGENT_TOP_P=0.95
AGENT_CHAT_GUEST_DAILY_QUOTA=10
AGENT_CHAT_REGISTERED_DAILY_QUOTA=100
AGENT_ALLOWED_BASE_URL_HOSTS=
AGENT_ALLOW_INSECURE_BASE_URL=false

# 代理 / 下载 / 纠偏 / 监控
PROXY_RATE_LIMIT=0
PROXY_ALLOW_PRIVATE_HOSTS=false
PROXY_VERIFY_SSL=true
PROXY_ALLOWED_HOSTS=
PROXY_DNS_GUARD=true
PROXY_MAX_RESPONSE_MB=32
PROXY_HTTP_TIMEOUT_SECONDS=20
PROXY_HTTP_CONNECT_TIMEOUT_SECONDS=5
PROXY_MAX_CONNECTIONS=100
PROXY_MAX_KEEPALIVE_CONNECTIONS=20
PROXY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
SHIPS66_TILE_URL_TEMPLATE=http://g3.ships66.com/maps/one/{z}/{x}/{y}.png

GCJRE_TILE_MAX_MB=8
GCJRE_MAX_IMAGE_PIXELS=16777216
GCJRE_MAX_TILES_PER_REQUEST=64
GCJRE_MAX_CONCURRENCY=16
DOWNLOAD_TASK_DB_PATH=/tmp/webgis_download_tasks.db
DOWNLOAD_OUTPUT_DIR=/tmp
DOWNLOAD_TASK_TTL_MINUTES=30
DOWNLOAD_TOKEN_LIFETIME_MINUTES=60
GCJRE_CACHE=
WEBGIS_LOG_STREAM_MODE=auto
WEBGIS_ASSUME_HF_SPACE=false
WEBGIS_ASSUME_IN_CONTAINER=false
HF_RUN_LOGS_URL=https://huggingface.co/api/spaces/NEGIAO/WebGIS/logs/run
HF_BUILD_LOGS_URL=https://huggingface.co/api/spaces/NEGIAO/WebGIS/logs/build
RUNTIME_CONFIG_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# 第三方公开服务端点（Key 不在此处：高德/Agent Key 属 L2，LOG/Supabase/OAuth secret 属 L3）
AMAP_REST_ROOT=https://restapi.amap.com
AMAP_WEB_DETAIL_ENDPOINT=https://www.amap.com/detail/get/detail
AMAP_WEB_REFERER=https://www.amap.com/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_SEARCH_ENDPOINT=https://nominatim.openstreetmap.org/search
EPSG_PROJ4_ENDPOINT=https://epsg.io/{code}.proj4
EXTERNAL_PROXY_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_PROXY_READ_TIMEOUT_SECONDS=8
EXTERNAL_PROXY_WRITE_TIMEOUT_SECONDS=8
EXTERNAL_PROXY_POOL_TIMEOUT_SECONDS=3
EXTERNAL_PROXY_MAX_CONNECTIONS=120
EXTERNAL_PROXY_MAX_KEEPALIVE_CONNECTIONS=60
EXTERNAL_PROXY_USER_AGENT=WebGIS-Backend/1.0

IP_GEO_AMAP_ENDPOINT=https://restapi.amap.com/v3/ip
IP_GEO_IP_API_ENDPOINT=https://ip-api.com/json
IP_GEO_IPAPI_ENDPOINT=https://ipapi.co
IP_GEO_TIMEOUT_CONNECT_SECONDS=3
IP_GEO_TIMEOUT_READ_SECONDS=5
IP_GEO_TIMEOUT_WRITE_SECONDS=5
IP_GEO_TIMEOUT_POOL_SECONDS=3
IP_GEO_USER_AGENT=WebGIS-Backend/2.0
IP_GEO_CACHE_TTL_SECONDS=3600
IP_GEO_CACHE_MAX_SIZE=2000

# Supabase 非密钥表名（URL/Key 属 L3）
SUPABASE_VISITS_TABLE=visit_tracking_events
SUPABASE_TABLE_NAME=visit_tracking_events

# Google OAuth Client ID（L1 公开，OAuth 流程必需）
GOOGLE_OAUTH_CLIENT_ID=101215058593-ofrhrkd7304ji8klf6gatjavsifa8pha.apps.googleusercontent.com

# 前端公开构建变量（Vite envDir=仓库根）
VITE_BASE_URL=./
VITE_BACKEND_URL=http://localhost:7860
VITE_GOOGLE_OAUTH_CLIENT_ID=101215058593-ofrhrkd7304ji8klf6gatjavsifa8pha.apps.googleusercontent.com
VITE_TILE_PROXY_BASE_URL=http://localhost:7860
VITE_TILE_PROXY_MODE=fallback
VITE_DOWNLOAD_REQUEST_TIMEOUT=2000000
VITE_BACKEND_REQUEST_TIMEOUT_MS=20000
VITE_AGENT_REQUEST_TIMEOUT_MS=60000
VITE_SPATIAL_ANALYSIS_TIMEOUT_MS=30000
VITE_TILE_CAPABILITIES_TIMEOUT_MS=10000
VITE_TILE_REQUEST_TIMEOUT_MS=15000
VITE_CESIUM_CDN_BASE_URLS=https://cdn.jsdelivr.net/npm/cesium@1.132/Build/Cesium/,https://cdn.bootcdn.net/ajax/libs/cesium/1.132.0/,https://unpkg.com/cesium@1.132.0/Build/Cesium/
VITE_CESIUM_CDN_ATTEMPT_TIMEOUT_MS=10000
VITE_TIANDITU_API_BASE_URL=https://api.tianditu.gov.cn
VITE_TIANDITU_SEARCH_DEFAULT_BOUND=73.5,18.2,135.0,53.5
VITE_DISTRICT_BOUNDARY_BASE_URL=https://geo.datav.aliyun.com/areas_v3/bound
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPTILER_KEY=
VITE_GEOVISEARTH_TOKEN=
