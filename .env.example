##############################################################################
# WebGIS-Dev 配置全集清单（权威入口）
#
# 三层安全模型：
#   [L1] 根目录 .env        — 不涉密 / 低密 / 持久常量（本文件可写默认值）
#   [L2] 管理员面板 + DB    — 常变运营配置（此处只登记，真值勿提交 git）
#   [L3] HF Space Secrets   — 绝密（此处必须留空；生产只在 HF 配置）
#
# 使用：
#   1. 复制本文件为仓库根目录 .env（已被 .gitignore 忽略）
#   2. 填写 [L1]；本地开发可把 [L3] 临时写入 .env；生产 [L3] 只配 HF Secrets
#   3. 启动后用 admin 登录，在 Admin 面板配置 [L2]（LLM Key、高德 Key 与 LLM 参数都走这里）
#
# 说明：Docs/Guide/configuration.md
# 计划：Docs/Guide/configuration-architecture-plan.md
#
# 前端注意：Vite 只把 VITE_* 前缀项打进浏览器构建产物（envDir=仓库根，
# 本地读根 .env、生产读根 .env.production）；其余变量不会泄漏给前端。
# 绝密永远不要写成 VITE_*。
##############################################################################


# ============================================================================
# [L1] 低密 / 不涉密 — 可写入本地 .env
# ============================================================================

# --- 运行环境 ---
# development | production（本地 docker-compose 建议 APP_ENV=development）
APP_ENV=development
LOG_LEVEL=INFO

# --- 对外 URL（OAuth 回调与前端回跳优先由此推导）---
BACKEND_PUBLIC_URL=http://localhost:7860
FRONTEND_PUBLIC_URL=http://localhost:5173
# 生产示例：
# BACKEND_PUBLIC_URL=https://negiao-webgis.hf.space
# FRONTEND_PUBLIC_URL=https://negiao.github.io/WebGIS-Dev

# Google/GitHub 控制台 Authorized redirect URI：
#   {BACKEND_PUBLIC_URL}/api/auth/oauth/google/callback
#   {BACKEND_PUBLIC_URL}/api/auth/oauth/github/callback
# 以下四项可选覆盖（留空则用 BACKEND/FRONTEND_PUBLIC_URL 推导）
# GOOGLE_OAUTH_REDIRECT_URI=
# GITHUB_OAUTH_REDIRECT_URI=
# FRONTEND_OAUTH_SUCCESS_URL=
# FRONTEND_OAUTH_FAILURE_URL=

# --- 认证持久化 ---
# HF 建议 /data/webgis_auth.db；本地可留空由代码回退
AUTH_DB_PATH=
AUTH_SESSION_EXPIRE_HOURS=72
AUTH_PASSWORD_HASH_ITERATIONS=120000

# --- OAuth 非密钥策略 ---
OAUTH_STATE_TTL_SECONDS=600
OAUTH_TICKET_TTL_SECONDS=120

# --- 邮件（账号在此 L1；凭证 SMTP_PASSWORD 见 L3，分开存取）---
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=80
# 发件账号（半公开，收件人可见；示例 no-reply@your-domain.com）
SMTP_USER=

# --- Agent / LLM 非密钥默认（常变以 L2 Admin 覆盖）---
AGENT_BASE_URL=https://api.qnaigc.com/v1
AGENT_MODEL=
AGENT_SYSTEM_PROMPT=You are the WebGIS assistant. Reply in concise Chinese unless the user asks for another language.
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TOKENS=32768
AGENT_TEMPERATURE=1.0
AGENT_TOP_P=0.95
AGENT_CHAT_GUEST_DAILY_QUOTA=10
AGENT_CHAT_REGISTERED_DAILY_QUOTA=100
# 调用方 override_base_url 安全护栏（默认即安全，通常无需改）：
# 白名单留空 = 不限制服务商域名（仍强制「override_base_url 必须与 override_api_key 成对出现」+ 拒私网/回环）
# AGENT_ALLOWED_BASE_URL_HOSTS=api.openai.com,api.deepseek.com
# 仅本地调试自建 http 上游时置 true（且只放行 127.0.0.1/localhost），生产恒 false
# AGENT_ALLOW_INSECURE_BASE_URL=false

# --- 代理 / 下载 / 纠偏 / 监控 ---
PROXY_RATE_LIMIT=0
# PROXY_ALLOW_PRIVATE_HOSTS=false
# PROXY_VERIFY_SSL=true
# 代理 SSRF 护栏（默认值即安全，正常公网瓦片源不受影响）
# PROXY_ALLOWED_HOSTS=            # host 白名单，逗号分隔，支持 *.example.com；留空=不启用
# PROXY_DNS_GUARD=true            # 解析 host 后按私网/回环复判（堵域名指向内网）
# PROXY_MAX_RESPONSE_MB=32        # 通用代理响应体上限；≤0=不限制
# GCJRE_TILE_MAX_MB=8             # 纠偏单瓦片字节上限
# GCJRE_MAX_IMAGE_PIXELS=16777216 # 纠偏解码像素上限（防解压炸弹）
# GCJRE_MAX_TILES_PER_REQUEST=64  # 纠偏单请求合成瓦片数上限
# GCJRE_MAX_CONCURRENCY=16        # 纠偏瓦片抓取并发上限（原硬编码 100）
# DOWNLOAD_TASK_DB_PATH=
# GCJRE_CACHE=
# WEBGIS_LOG_STREAM_MODE=auto
# WEBGIS_ASSUME_HF_SPACE=
# WEBGIS_ASSUME_IN_CONTAINER=
# RUNTIME_CONFIG_ALLOWED_ORIGINS=https://negiao.github.io,http://localhost:5173
# 全局 CORS 来源白名单（逗号分隔；留空 = 允许所有来源。生产建议配置）
# CORS_ALLOWED_ORIGINS=https://negiao.github.io,http://localhost:5173,http://localhost:4173

# --- Supabase 非密钥表名（URL/Key 见 L3）---
# SUPABASE_VISITS_TABLE=visits
# SUPABASE_TABLE_NAME=visits

# --- 前端公开构建变量（Vite envDir=仓库根：本地读根 .env，本段即生效；生产读根 .env.production）---
VITE_BASE_URL=./
VITE_BACKEND_URL=http://localhost:7860
VITE_TILE_PROXY_BASE_URL=http://localhost:7860
VITE_TILE_PROXY_MODE=fallback
# VITE_DOWNLOAD_REQUEST_TIMEOUT=2000000
# Pages 构建示例：
# VITE_BASE_URL=/WebGIS-Dev/
# VITE_BACKEND_URL=https://negiao-webgis.hf.space
# VITE_TILE_PROXY_BASE_URL=https://negiao-webgis.hf.space


# ============================================================================
# [L2] 管理员面板 + 数据库 — 仅登记；真值在 Admin 配置，勿提交 git
# 登录：账号 admin；密码 = L3 SUPER_USER
# （本地 APP_ENV=development 且未设 SUPER_USER 时开发默认 123456）
# 对照表（L2 项 ↔ Admin 菜单 ↔ DB 表/键）：Docs/Guide/configuration.md
# ============================================================================

# 地图 Token 池（api_keys 表 + GET /api/runtime-config/map-tokens）
# 位置：用户中心 → API 密钥管理
# tianditu_tk / cesium_ion_token / amap_key（高德 Web 服务 Key）
# 旧 env 名 AMAP_WEB_SERVICE_KEY / AMAP_KEY / GAODE_KEY 仅兼容存量，不再写入 HF Secrets。
#
# Agent / LLM 主密钥池（api_keys 表，主备轮换）
# 位置：用户中心 → API 密钥管理 → Agent
# agent_api_key（兼容旧名 agent_token）；旧 env 名 AGENT_API_KEY / AGENT_TOKEN 仅兼容存量。
# 注意：LLM 主密钥和高德 Web 服务 Key 属 L2 管理员配置，真值不要提交 git，也不要新增到 HF Secrets。

# Agent 运营参数（system_config 表）
# 位置：用户中心 → 管理员控制台 → LLM 对话参数配置
# L2_AGENT_BASE_URL / L2_AGENT_MODEL / L2_AGENT_AVAILABLE_MODELS
# L2_AGENT_SYSTEM_PROMPT / L2_AGENT_TIMEOUT / MAX_TOKENS / TEMPERATURE / TOP_P
# L2_AGENT_CHAT_GUEST_DAILY_QUOTA / L2_AGENT_CHAT_REGISTERED_DAILY_QUOTA
# L2_DEFAULT_AI_API_KEY（管理员配置）/ L2_DEFAULT_AI_BASE_URL / L2_DEFAULT_AI_MODEL

# 站点运营（system_config / announcements 表）
# 位置：用户中心 → 管理员控制台 → 系统配置 / 地图默认配置
# L2_DEFAULT_BASEMAP_INDEX / L2_ADMIN_CONTACT / L2_ANNOUNCEMENT / L2_ADMIN_AVATAR_INDEX


# ============================================================================
# [L3] 绝密 — HF Space Secrets（或本地未提交 .env）
# 已提交的 .env.example 中必须留空。禁止把真值推进 git。
# ============================================================================

# 管理员密码（用户名固定 admin）
SUPER_USER=

# OAuth state 签名密钥（生产必填）
OAUTH_STATE_SECRET=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 邮件凭证（账号 SMTP_USER 在 L1 段，分开存取）
SMTP_PASSWORD=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# 监控日志流访问令牌（/api/monitor 鉴权用；不设则按代码默认策略）
# LOG=


# ============================================================================
# 平台自动注入（一般不用手写）：SPACE_ID / HF_SPACE_ID / SPACE_REPO_NAME ...
# ============================================================================


# ============================================================================
# 最小可运行检查
# 1) 本地：APP_ENV=development + VITE_BACKEND_URL + docker up
#    → 游客 user/123；admin/123456（未设 SUPER_USER）
# 2) 邮箱注册：L1 SMTP_USER + L3 SMTP_PASSWORD（账号/凭证分开存取）
# 3) OAuth：L3 四个客户端项 + OAUTH_STATE_SECRET + 控制台回调
# 4) 地图：admin 配 L2 天地图/Cesium/高德
# 5) AI：admin 配 L2 AGENT_API_KEY + base_url/model/额度/提示词；不要把 LLM 参数硬编码到 HF
# 6) HF：只把 [L3] 配到 Secrets；L1 URL 改为生产域名
# ============================================================================
