# ============================================================
# WebGIS 本地开发环境配置（L1 层）
# 本文件 = 本地开发基线，由 Vite 、后端py读取
# 部署环境使用同目录 .env（npm run build 读取）
# ============================================================

# 本地开发模式（开发环境为 .env 的 production）
APP_ENV=development

# 对外 URL：APP_ENV=development 时后端自动推导为 localhost
BACKEND_PUBLIC_URL=http://localhost:7860
FRONTEND_PUBLIC_URL=http://localhost:5173

# 前端本地开发变量（npm run dev 生效，npm run build 不读此文件）
# vite中已经配置了server，将/api代理到后端，后端不需要再配置跨域
VITE_BACKEND_URL=/api
VITE_TILE_PROXY_BASE_URL=/api

# 瓦片内存缓存（10 分钟 TTL，纯内存不持久化）
PROXY_TILE_CACHE_TTL_SECONDS=600
PROXY_TILE_CACHE_MAX_SIZE=200000

# 访客账号密码
GUEST_PASSWORD=123456
GUEST_USERNAME=user         #后端密码，二者需一致
VITE_GUEST_PASSWORD=123456  #前端密码，Vite 变量必须 VITE_ 前缀，后端不读此文件

DOWNLOAD_ALLOW_PRIVATE_HOSTS=true