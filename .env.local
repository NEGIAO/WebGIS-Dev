# ============================================================
# WebGIS 本地开发环境配置（L1 不涉密，提交 git）
# 本文件 = 本地开发基线，npm run dev 由 Vite 读取
# 部署环境使用同目录 .env（npm run build 读取）
# ============================================================

# 本地开发模式（覆盖 .env 的 production）
APP_ENV=development

# 对外 URL：APP_ENV=development 时后端自动推导为 localhost
BACKEND_PUBLIC_URL=http://localhost:7860
FRONTEND_PUBLIC_URL=http://localhost:5173

# 前端本地开发变量（npm run dev 生效，npm run build 不读此文件）
VITE_BACKEND_URL=http://localhost:7860
VITE_TILE_PROXY_BASE_URL=http://localhost:7860
